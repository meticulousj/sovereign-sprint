{
  "workspace": {
    "name": "90-Day Sovereign Sprint",
    "icon": "📋",
    "description": "A complete system for 90 days of recorded proof. Daily protocols, weekly reflections, milestone checkpoints, and pattern tracking."
  },
  "pages": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "type": "page",
      "icon": "📊",
      "content": "# 90-Day Sovereign Sprint Dashboard\n\n## Quick Stats\n- Days Completed: [Database Formula]\n- Weekly Completion Rate: [Database Formula]\n- Consistency Streak: [Database Formula]\n- Wins Logged: [Database Formula]\n- Patterns Identified: [Database Formula]\n\n## This Week\n- Week Number: [Manual or Formula]\n- Theme: [Linked to Weekly Reflections]\n- Focus: [From latest weekly reflection]\n- Rituals This Week: [Database Formula]\n\n## Navigation\n- Daily Log\n- Weekly Reflections\n- Milestones\n- Wins Archive\n- Patterns Tracker\n\n## Recent Wins\n[Embed: Wins database, filtered to last 7 days]\n\n## Current Focus\n[Text block for user to fill in]"
    }
  ],
  "databases": [
    {
      "id": "daily-log",
      "title": "Daily Log",
      "icon": "📓",
      "description": "Daily entries with morning ignition, midday recalibration, and evening audit",
      "properties": [
        {
          "name": "Date",
          "type": "date",
          "required": true
        },
        {
          "name": "Day",
          "type": "number",
          "description": "Day number (1-90)"
        },
        {
          "name": "Week",
          "type": "number",
          "description": "Week number (1-13)"
        },
        {
          "name": "Theme",
          "type": "select",
          "options": [
            "Identity Friction",
            "Energy Command",
            "Focus Containment",
            "Execution Standards",
            "Distraction Audit",
            "Environment Design",
            "Trust Repair",
            "Momentum Compounding",
            "Proof Integration",
            "Season Closure",
            "Next-Season Map",
            "Sovereign Handoff",
            "Final Integration"
          ]
        },
        {
          "name": "Daily Question",
          "type": "text"
        },
        {
          "name": "Morning Ignition",
          "type": "text"
        },
        {
          "name": "Midday Recalibration",
          "type": "text"
        },
        {
          "name": "Evening Audit",
          "type": "text"
        },
        {
          "name": "Daily Score",
          "type": "number",
          "description": "Rating 1-10"
        },
        {
          "name": "Rituals Completed",
          "type": "checkbox"
        },
        {
          "name": "Wins",
          "type": "text"
        },
        {
          "name": "Patterns",
          "type": "text"
        },
        {
          "name": "Energy Level",
          "type": "select",
          "options": ["Low", "Medium", "High"]
        },
        {
          "name": "Mood",
          "type": "select",
          "options": ["Energized", "Steady", "Struggling", "Recovering"]
        },
        {
          "name": "Status",
          "type": "select",
          "options": ["On-track", "Struggling", "Off-track"]
        },
        {
          "name": "Tags",
          "type": "multi_select",
          "options": [
            "#morning-ignition",
            "#midday-recalibration",
            "#evening-audit",
            "#win",
            "#pattern",
            "#breakthrough",
            "#struggle"
